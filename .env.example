# Copy to .env for local development, or set these as environment variables
# in your host's dashboard (e.g. Render's "Environment" tab) for deployment.

# Neo4j Aura connection password (used only for the fishing knowledge graph).
# Local Neo4j default shown; replace with your Aura instance's password.
NEO4J_PASSWORD=

# MongoDB Atlas connection string (free M0 cluster). Stores users, chats,
# feedback, contributions, settings and admin config. Required — the app
# will refuse to start without it. Example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Ollama Cloud API key (from https://ollama.com -> Settings -> API Keys).
# Required for chat/keyword-extraction/title-generation to work once
# OLLAMA_URL points at https://ollama.com/api/chat (the default in this fork).
# Leave blank only if you've pointed OLLAMA_URL back at a local Ollama instance.
OLLAMA_API_KEY=

# Optional: path to a Google Cloud service-account JSON key, only needed if
# you want the /transcribe (voice input) endpoint to work.
GOOGLE_APPLICATION_CREDENTIALS=
